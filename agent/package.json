{
  "name": "orvantra-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Orvantra invoice-reading agent: dual NEAR AI Cloud readers, checks against on-chain registry and treasury policy",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "analyze": "tsx src/cli.ts",
    "eval": "tsx src/eval.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "chain-state": "tsx scripts/chain-state.ts",
    "pay": "tsx src/pay.ts",
    "web-run": "tsx src/web-run.ts",
    "setup-agent-key": "tsx scripts/setup-agent-key.ts",
    "prove-key-limits": "tsx scripts/prove-key-limits.ts",
    "quote": "tsx scripts/quote.ts",
    "oneclick-status": "tsx scripts/oneclick-status.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "notifier": "tsx src/notify/run.ts"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.26",
    "@napi-rs/canvas": "^1.1.0",
    "@near-js/crypto": "^2.5.1",
    "@near-js/transactions": "^2.5.1",
    "@near-js/utils": "^2.5.1",
    "@nearai/inference-sdk": "^0.2.1",
    "dotenv": "^18.0.9",
    "pdf-to-img": "^7.0.2",
    "pdfjs-dist": "~6.4.299"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
